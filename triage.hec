    def _build_right(self):
        self._right_panel = QWidget()
        lay = QVBoxLayout(self._right_panel)
        lay.setContentsMargins(0, 0, 0, 0); lay.setSpacing(0)

        if PYVISTA_AVAILABLE:
            try:
                self.plotter = QtInteractor(self._right_panel)
                self.plotter.set_background('#f8f9fb')
                self.plotter.add_axes(color="#555577", viewport=(0.0, 0.0, 0.12, 0.15))
                self.plotter.track_click_position(callback=self._on_click, side='right')
            
                lay.addWidget(self.plotter.interactor)
                self.log("Viewport online — right-click element to see info")
            except Exception as e:
                self.plotter = None
                lay.addWidget(QLabel("Viewport failed"))
                self.log(f"Viewport error: {e}")
        else:
            self.plotter = None
            lb = QLabel("PyVista not installed\npip install pyvista pyvistaqt")
            lb.setAlignment(Qt.AlignCenter); lay.addWidget(lb)

        self._build_bottom_bar(lay)
        return self._right_panel

