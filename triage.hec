# Columns that are always in GENERAL (built-in, non-dynamic)
BUILTIN_GENERAL_COLS = {
    "Property ID", "Type", "T", "W", "Core T", "Core MAT", "Class",
    "n1", "n2", "n3", "n4", "Ftu (A-basis)", "Fty (A-basis)",
    "CAI fwidth", "Crippling Section",
