def _is_sep(col: str) -> bool:
    return col.startswith("──") or col == "Default View"


def _build_left_qss(t: dict) -> str:
    return f"""
QWidget#LeftPanel {{
    background-color: {t['panel_bg']};
    border: none;
}}
QGroupBox {{
    background-color: {t['group_bg']};
    border: 1px solid {t['group_border']};
    border-top: 3px solid {t['group_title']};
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 14px;
    font-weight: bold;
    font-size: 10px;
    color: {t['text']};
    letter-spacing: 1px;
}}
QGroupBox::title {{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    background-color: {t['group_bg']};
    color: {t['group_title']};
}}
QLabel {{
    background-color: transparent;
    color: {t['text']};
    font-size: 11px;
}}
QLineEdit {{
    background-color: {t['input_bg']};
    border: 1px solid {t['input_border']};
    border-radius: 4px;
    padding: 5px 8px;
    color: {t['text']};
    font-size: 11px;
}}
QLineEdit:read-only {{ color: {t['dim']}; }}
QLineEdit:focus {{ border-color: {t['accent']}; }}
QPushButton {{
    background-color: {t['btn_bg']};
    border: 1px solid {t['btn_border']};
    border-radius: 4px;
    padding: 6px 14px;
    color: {t['text']};
    font-size: 11px;
    font-weight: 600;
}}
QPushButton:hover {{
    background-color: {t['btn_hover']};
    color: {t['btn_hover_txt']};
    border-color: {t['btn_hover']};
}}
QPushButton:pressed {{
    background-color: {t['accent']};
    color: {t['btn_hover_txt']};
}}
QPushButton:disabled {{
    color: {t['dim']};
    border-color: {t['group_border']};
    background-color: {t['group_bg']};
}}
QPushButton:checked {{
    background-color: {t['accent']};
    color: {t['btn_hover_txt']};
    border-color: {t['accent']};
}}
QComboBox {{
    background-color: {t['input_bg']};
    border: 1px solid {t['input_border']};
    border-radius: 4px;
    padding: 5px 8px;
    color: {t['text']};
    font-size: 11px;
}}
QComboBox:hover {{ border-color: {t['accent']}; }}
QComboBox::drop-down {{ border: none; width: 20px; }}
QComboBox::down-arrow {{
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid {t['dim']};
    width: 0; height: 0; margin-right: 5px;
}}
QComboBox QAbstractItemView {{
    background-color: {t['input_bg']};
    color: {t['text']};
    border: 1px solid {t['input_border']};
    selection-background-color: {t['accent']};
    selection-color: {t['btn_hover_txt']};
    outline: none;
}}
QTextEdit {{
    background-color: {t['log_bg']};
    border: 1px solid {t['group_border']};
    border-left: 3px solid {t['log_border']};
    color: {t['log_text']};
    font-family: 'Courier New', monospace;
    font-size: 10px;
    border-radius: 3px;
}}
QRadioButton {{
    color: {t['text']};
    font-size: 11px;
    spacing: 5px;
    background-color: transparent;
}}
QRadioButton::indicator {{
    width: 13px; height: 13px;
    border: 2px solid {t['group_border']};
    border-radius: 7px;
    background-color: {t['input_bg']};
}}
QRadioButton::indicator:checked {{
    background-color: {t['accent']};
    border-color: {t['accent']};
}}
QScrollBar:vertical {{
    background: {t['panel_bg']}; width: 8px; border: none;
}}
QScrollBar::handle:vertical {{
    background: {t['group_border']}; min-height: 20px; border-radius: 4px;
}}
QScrollBar::handle:vertical:hover {{ background: {t['accent']}; }}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
"""


def _build_menubar_qss(t: dict) -> str:
    return f"""
QMenuBar {{
    background-color: {t['menubar_bg']};
    color: {t['menubar_txt']};
    padding: 2px;
    border-bottom: 1px solid {t['group_border']};
    font-size: 11px;
}}
QMenuBar::item {{
    background-color: transparent;
    padding: 6px 14px;
    color: {t['menubar_txt']};
    border-radius: 3px;
}}
QMenuBar::item:selected {{
    background-color: {t['menu_sel_bg']};
    color: {t['menu_sel_txt']};
}}
QMenu {{
    background-color: {t['menu_bg']};
    color: {t['menubar_txt']};
    border: 1px solid {t['group_border']};
    border-radius: 4px;
    padding: 4px 0;
}}
QMenu::item {{
    padding: 7px 28px 7px 12px;
    font-size: 11px;
    color: {t['menubar_txt']};
}}
QMenu::item:selected {{
    background-color: {t['menu_sel_bg']};
    color: {t['menu_sel_txt']};
}}
QMenu::separator {{
    height: 1px;
    background: {t['group_border']};
    margin: 3px 8px;
}}
"""


def _build_bottombar_qss(t: dict) -> str:
    return f"""
QWidget#BottomBar {{
    background-color: {t['panel_bg']};
    border-top: 1px solid {t['group_border']};
}}
QLabel {{
    color: {t['dim']};
    font-size: 10px;
    background-color: transparent;
}}
QComboBox {{
    background-color: {t['input_bg']};
    border: 1px solid {t['input_border']};
    border-radius: 3px;
    padding: 4px 8px;
    color: {t['text']};
    font-size: 10px;
}}
QComboBox::drop-down {{ border: none; width: 16px; }}
QComboBox::down-arrow {{
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 5px solid {t['dim']};
    width: 0; height: 0; margin-right: 4px;
}}
QComboBox QAbstractItemView {{
    background-color: {t['input_bg']};
    color: {t['text']};
    border: 1px solid {t['input_border']};
    selection-background-color: {t['accent']};
    selection-color: {t['btn_hover_txt']};
}}
QPushButton#RenderBtn {{
    background-color: {t['accent']};
    color: {t['btn_hover_txt']};
    border: none;
    border-radius: 3px;
    padding: 5px 12px;
    font-size: 10px;
    font-weight: bold;
}}
QPushButton#RenderBtn:hover {{
    background-color: {t['btn_bg']};        
    color: {t['accent']};                   
    border: 1px solid {t['accent']};        
}}
QPushButton#RenderBtn:pressed {{
    background-color: {t['group_border']};
    color: {t['accent']};
}}
QPushButton#LabelBtn {{
    background-color: {t['btn_bg']};
    color: {t['text']};
    border: 1px solid {t['btn_border']};
    border-radius: 3px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}}
QPushButton#LabelBtn:hover {{
    background-color: {t['btn_hover']};
    color: {t['btn_hover_txt']};
    border-color: {t['btn_hover']};
}}
QPushButton#LabelBtn:checked {{
    background-color: {t['accent']};
    color: {t['btn_hover_txt']};
    border-color: {t['accent']};
}}
QSlider {{
    background-color: transparent;
}}
QSlider::groove:horizontal {{
    height: 4px;
    background: {t['group_border']};
    border-radius: 2px;
}}
QSlider::handle:horizontal {{
    background: {t['accent']};
    width: 12px; height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}}
QSlider::sub-page:horizontal {{
    background: {t['accent']};
    border-radius: 2px;
}}
QLabel#OpacityVal {{
    color: {t['accent']};
    font-weight: bold;
    min-width: 30px;
    font-size: 10px;
    background: transparent;
}}
QLabel#PickStatus {{
    background-color: transparent;
    color: {t['accent']};
    padding: 5px 4px;
    border: none;
    font-size: 10px;
    font-weight: bold;
    min-width: 0px;
}}
QFrame#BarSep {{
    background-color: {t['group_border']};
    max-width: 1px;
}}
"""


# =============================================================================
# MAIN APPLICATION
# =============================================================================
class MISGEN_App(QMainWindow):

    def __init__(self):
        super().__init__()
        self.setWindowTitle("MISGEN — Interactive Structural Viewer")
        self.setGeometry(60, 60, 1700, 950)
        self.setMinimumSize(800, 500)

        self.bdf             = None
        self.df_general      = None
        self.df_join         = None
        self.df_stats        = None
        self.bdf_path_str    = None
        self.excel_path_str  = None

        self.current_mesh        = None
        self.current_pid_data    = None
        self.current_eid_data    = None
        self.current_column_data = None
        self.pid_labels_actor    = None

        self._eid_val_map    = {}
        self._picking_active = False
        self._selected_type  = None
        self._pid_color_map  = {}
        self._viz_actors     = []
        self._current_col    = "Default View"
        self._picked_actor = None
        self._hidden_pids = set()

        # Points / node-map cache — invalidated on BDF reload
        self._pts_cache  = None
        self._nmap_cache = None

        self._theme_name = "Default"
        self._theme      = THEMES["Default"]

        self._init_ui()
        self._apply_theme("Default")

    # =========================================================================
    # THEME
    # =========================================================================
    def _apply_theme(self, name: str):
        if name not in THEMES:
            return
        self._theme_name = name
        self._theme      = THEMES[name]
        t = self._theme

        self.left_panel.setStyleSheet(_build_left_qss(t))
        self.menuBar().setStyleSheet(_build_menubar_qss(t))
        self.bottom_bar.setStyleSheet(_build_bottombar_qss(t))

        self.centralWidget().setStyleSheet(f"background-color: {t['panel_bg']};")
        self._right_panel.setStyleSheet(f"background-color: {t['vp_bg_hex']};")
        self._splitter.setStyleSheet(
            f"QSplitter::handle {{ background-color: {t['splitter_bg']}; width: 2px; }}"
        )

        if self.plotter:
            self.plotter.set_background(t["vp_bg_hex"])
            try:
                self.plotter.add_axes(color=t["axes_color"], viewport=(0.0, 0.0, 0.12, 0.15))
            except Exception:
                pass
            self.plotter.render()

        self._pid_color_map.clear()

        if self.bdf:
            col = self._current_col
            if not _is_sep(col) and col and self.df_general is not None:
                self._display_col()
            else:
                self._viz_default()

    def _discrete_colors(self, unique_vals):
        disc = self._theme["discrete"]
        return {v: disc[i % len(disc)] for i, v in enumerate(unique_vals)}

    def _pid_color(self, pid):
        disc = self._theme["discrete"]
        if pid not in self._pid_color_map:
            self._pid_color_map[pid] = disc[len(self._pid_color_map) % len(disc)]
        return self._pid_color_map[pid]

    # =========================================================================
    # UI BUILD
    # =========================================================================
    def _init_ui(self):
        self._build_menubar()
        main = QWidget()
        self.setCentralWidget(main)
        root = QHBoxLayout(main)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)
        self._splitter = QSplitter(Qt.Horizontal)
        self._splitter.setHandleWidth(2)
        root.addWidget(self._splitter)
        self._splitter.addWidget(self._build_left())
        self._splitter.addWidget(self._build_right())
        self._splitter.setSizes([430, 1270])

    # -------------------------------------------------------------------------
    # MENU BAR
    # -------------------------------------------------------------------------
    def _build_menubar(self):
        mb = self.menuBar()

        fm = mb.addMenu("File")
        a = fm.addAction("📁  Open BDF File…"); a.setShortcut("Ctrl+O")
        a.triggered.connect(self._browse_bdf)
        a = fm.addAction("📊  Open Excel File…")
        a.triggered.connect(self._browse_excel)
        fm.addSeparator()
        a = fm.addAction("⬆  Export MISC Excel…")
        a.triggered.connect(self._export_excel)
        fm.addSeparator()
        a = fm.addAction("❌  Exit"); a.setShortcut("Ctrl+Q")
        a.triggered.connect(self.close)

        vm = mb.addMenu("View")
        a = vm.addAction("🔁  Refresh Visualization"); a.setShortcut("F5")
        a.triggered.connect(self._re_render)
        a = vm.addAction("🏠  Reset Camera")
        a.triggered.connect(lambda: (self.plotter.reset_camera(), self.plotter.render()) if self.plotter else None)
        vm.addSeparator()
        a = vm.addAction("🏷  Toggle PID Labels")
        a.triggered.connect(self._toggle_labels)

        tm = mb.addMenu("Themes")
        icons = {"Default": "⚙️", "Light": "☀️", "Dark": "🌙",
         "Ocean Blue": "🌊", "Forest Green": "🌲", "Cyber": "⚡"}
        grp = QActionGroup(self); grp.setExclusive(True)
        for name in THEMES:
            a = tm.addAction(f"{icons.get(name, '●')}  {name}")
            a.setCheckable(True); a.setChecked(name == "Default")
            a.triggered.connect(lambda checked, n=name: self._apply_theme(n))
            grp.addAction(a)

        am = mb.addMenu("About")
        a = am.addAction("ℹ️  About MISGEN"); a.triggered.connect(self._show_about)
        a = am.addAction("❓  Help");         a.triggered.connect(self._show_help)

